<Window x:Name="Main" x:Class="TrenaEscala.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TrenaEscala"
        mc:Ignorable="d"
        Title="Tren A Escala" Height="960" Width="1280"
        WindowState="Maximized">
    <Grid x:Name="GridBase">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ColumnaIzquierda" Width="300"/>
            <ColumnDefinition x:Name="ColumnaDerecha" Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Árbol de navegación -->
        <TreeView x:Name="ArbolNavegacion" Grid.Column="0"/>

        <!-- Parte derecha -->
        <Grid x:Name="GridDerecha" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="FilaListaModelos" Height="2*"/>
                <RowDefinition x:Name="SeparadorVertical" Height="5"/>
                <RowDefinition x:Name="FilaPropsModeloSeleccionado" Height="*"/>
            </Grid.RowDefinitions>

            <!-- Lista de modelos -->
            <DataGrid x:Name="ListaModelos" Grid.Row="0"/>

            <!-- Separador arrastrable -->
            <GridSplitter x:Name="SeparadorHorizontal" Grid.Row="1"
                      Height="5"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      ResizeDirection="Rows"/>

            <!-- Ficha del modelo -->
            <Grid x:Name="GridFichaModelo" Grid.Row="2"/>
        </Grid>
    </Grid>
</Window>
